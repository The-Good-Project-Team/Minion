{
  "name": "minion-desktop",
  "version": "3.2.1",
  "description": "Minion — a local-first chat agent and personal MCP for your private context graph.",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:browser": "bash scripts/dev-browser.sh",
    "build": "vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit -p tsconfig.json",
    "test:unit": "vitest run",
    "check:watch": "tsc --noEmit -p tsconfig.json --watch",
    "tauri": "tauri",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install-browsers": "playwright install chromium",
    "test:live": "bash scripts/live-smoke.sh",
    "test:prod-smoke": "bash scripts/prod-smoke.sh",
    "test:all": "bash scripts/verify-all.sh",
    "tauri:build:macos": "bunx tauri build && bash ./scripts/postbuild_macos_sanitize_app.sh && bash ./scripts/package_macos_zip.sh"
  },
  "license": "MIT",
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-slot": "^1.2.4",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@vitejs/plugin-react": "^5.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "three": "^0.184.0",
    "use-stick-to-bottom": "^1.1.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^3.2.4"
  }
}
